# Trading Command Center - Environment Variables
# Copy this file to .env and fill in your values

# ─── Tradovate API Credentials ────────────────────────────────────────────────
# Get these from: https://dashboards.tradovate.com → API Entitlement tab
# Or email support@tradovate.com to request API access

# Your Tradovate login username
TRADOVATE_USERNAME=your_tradovate_username

# Your Tradovate login password
TRADOVATE_PASSWORD=your_tradovate_password

# API Client ID (integer, from Tradovate dashboard)
TRADOVATE_CID=1234

# API Secret (string, from Tradovate dashboard)
TRADOVATE_SECRET=your_api_secret_here

# Set to 'true' for demo/simulation environment, 'false' for live trading
TRADOVATE_DEMO_MODE=true

# ─── Twitter API (optional, for Trump tweet feed) ─────────────────────────────
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Server Port (optional, defaults to 3001)
PORT=3001